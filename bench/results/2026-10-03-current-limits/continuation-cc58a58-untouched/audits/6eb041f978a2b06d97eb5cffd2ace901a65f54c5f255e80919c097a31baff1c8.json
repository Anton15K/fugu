      "findings": [
        {
          "confidence": "advisory",
          "detail": "All file tools accept arbitrary absolute paths (e.g., '../../../etc/passwd') and pass them directly to pathlib.Path without validating against a configured root directory. The docstring claims 'drop-in upgrade for the filesystem server' but the original filesystem server typically enforces a sandbox root; this implementation has no such restriction, allowing reads from anywhere the process can access.",
          "evidence": [
            {
              "excerpt": "def handle_read_file(path: str) -> dict:\n    p = Path(path)\n    return {\"path\": path, \"text\": p.read_text(encoding=\"utf-8\", errors=\"replace\")[:16000]}",
              "meta": {
                "kind": "code",
                "model_judged": true
              },
              "source": "semantic:handle_read_file:L60"
            }
          ],
          "owasp_ids": [
            "MCP02"
          ],
          "severity": "medium",
          "stage": "semantic",
          "title": "Path traversal / missing sandbox root enforcement"
        },
        {
          "confidence": "advisory",
          "detail": "The search_files handler returns only the first 100 matches (matches[:100]) but the tool description does not mention this limit, reducing completeness of the schema.",
          "evidence": [
            {
              "excerpt": "return {\"matches\": matches[:100]}",
              "meta": {
                "kind": "code",
                "model_judged": true
              },
              "source": "semantic:handle_search_files:L78"
            }
          ],
          "owasp_ids": [
            "LLM01"
          ],
          "severity": "info",
          "stage": "semantic",
          "title": "search_files silently truncates results at 100 matches"
        }
      ],
