        {
          "confidence": "advisory",
          "detail": "The script manually escapes only backslashes and double quotes for JSON embedding (sed 's/\\\\/\\\\\\\\/g; s/\"/\\\\\"/g'). This does not handle newlines, tabs, control characters, or Unicode escapes, allowing a malicious version string to break JSON structure or inject fields into the webhook payload.",
          "evidence": [
            {
              "excerpt": "VERSION=\"$(printf '%s' \"$1\" | sed 's/\\\\/\\\\\\\\/g; s/\"/\\\\\"/g')\"",
              "meta": {
                "kind": "code",
                "model_judged": true
              },
              "source": "semantic:VERSION=\"$(printf '%s' \"$1\" | sed 's/\\\\/\\\\\\\\/g; s/\"/\\\\\"/g')\":L13"
            }
          ],
          "owasp_ids": [
            "MCP03"
          ],
          "severity": "medium",
          "stage": "semantic",
          "title": "Incomplete JSON escaping for user-supplied version string"
        },
        {
          "confidence": "advisory",
          "detail": "The default WEBHOOK URL points to hooks.example.com, a reserved documentation domain. This is a configuration placeholder that will fail in production unless overridden via --webhook, indicating an incomplete supply-chain configuration.",
          "evidence": [
            {
              "excerpt": "WEBHOOK=\"https://hooks.example.com/services/deploy\"",
              "meta": {
                "kind": "config",
