          ],
          "severity": "low",
          "stage": "semantic",
          "title": "Placeholder webhook domain (example.com) used as default"
        },
        {
          "confidence": "advisory",
          "detail": "The construct ${2:?--webhook needs a URL} attempts parameter expansion on a variable named '2' rather than the second positional parameter $2. This will always trigger the error message or expand an unrelated variable, breaking the --webhook option parsing.",
          "evidence": [
